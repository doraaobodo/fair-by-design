# MV411   0.08975303 0.06867953
# NOMO1   0.07451775 0.03495918
# OCIAML3 0.08374091 0.06667432
# THP1    0.35880584 0.14529400
#
library(readxl)
library(data.table)
library(pheatmap)
library(ggplot2)
#########################
# Source the cellMCD library
user.id=Sys.info()[["user"]]
box.dir=paste0("C:/Users/",user.id,"/Box/AML-PG/")
################################
# get aml08 promise results
aml08.res.file=paste0(box.dir,"AnalysisReports/AML02-08-PROMISE/AM08._n152_RNSseq.PROMISE3_06_2022/CloAraC/report_list/AML08.RNAseq66.Clo-AraC.PR3_MRD1_EFS_OS-annotated.csv")
aml08.res=read.csv(aml08.res.file)
# put clinical results on z-scale
p.to.z = function(stat, pvec, log = FALSE){
if(isFALSE(log)){
z = sign(log(stat))*qnorm(
(pvec+1e-6)/2,lower.tail=F)
} else {
z = sign(stat)*qnorm(
(pvec+1e-6)/2,lower.tail=F)
}
return(z)}
base.names = c('MRD1', 'EFS','OS')
stat.cols = paste0(base.names, '.stat')
p.cols = paste0(base.names, '.perm.p')
z.cols = paste0('z.',base.names)
# compute each column as a list
z.list = mapply(
FUN       = p.to.z,
stat      = aml08.res[ stat.cols ],
pvec      = aml08.res[ p.cols ],
log       = TRUE,
SIMPLIFY  = FALSE,      # return a list, one element per column
USE.NAMES = FALSE       # don’t try to use stat.cols as names inside
)
# bind into a data.frame and assign
aml08.res[ z.cols ] = as.data.frame(z.list)
head(aml08.res[z.cols])
setDT(aml08.res)
aml08.res.ag = aml08.res[, lapply(.SD, mean, na.rm = TRUE),
by = GeneName,
.SDcols = z.cols]
aml08.mtx=as.matrix(aml08.res.ag[,-1])
rownames(aml08.mtx)=aml08.res.ag$GeneName
#############################
# get crispr data
nam.folder=paste0("C:/Users/",user.id,"/Box/AML-PG/CRISPR2023/Nam.Dissertation.CRISPR.061825/Final.Nine.Cell.Lines.MedianNorm.2024/Final.Nine.Cell.Lines.MedianNorm.2024/MLE/")
gene.files=list.files(nam.folder,pattern="gene_summary.txt",full.names=T)
line.names=gsub(".AllDrugs.gene_summary.txt","",basename(gene.files))
sub.line.names=setdiff(line.names, c("KASUMI1", "OCIAML2"))
line.data=list()
for (i in 1:length(gene.files)){
ld=data.table::fread(gene.files[i])
ld = as.data.frame(ld)
gn = ld$Gene
b.clms=grep("|z",colnames(ld),fixed=T,value=T)
ld = ld[, b.clms]
# ld = ld[, b.clms[-1]] - ld[, b.clms[1]]
rownames(ld) = gn
line.data[[i]] = ld
}
names(line.data)=line.names
araclo.cpr=as.data.frame(matrix(nrow = nrow(line.data[[1]]), ncol = 0))
for(ln in sub.line.names){
l = line.data[[ln]]
lade = l[, grep("AraC|Clofa", colnames(l)),drop=F]
araclo.cpr=cbind(araclo.cpr,lade)
}
#############################
# combine
shared.genes = intersect(
aml08.res.ag$GeneName,
rownames(araclo.cpr))
x = aml08.mtx[shared.genes, ]
# try y as each cell line:
ylist=list()
for(l in sub.line.names){
y=araclo.cpr[shared.genes,
grep(l, colnames(araclo.cpr))]
l
head(x)
head(y)
#############################
# get distance by distance plot
library(robustbase)
z=y
# z <- cbind(as.matrix(x), as.matrix(y))
n <- nrow(z); p <- ncol(z)
# Classical Mahalanobis distances
md <- sqrt(mahalanobis(z,
center = colMeans(z),
cov = cov(z)))
# Robust MCD estimates
mcd <- covMcd(z)
rd <- sqrt(mahalanobis(z,
center = mcd$center,
cov = mcd$cov))
cutoff <- sqrt(qchisq(0.975, df = p))
# outliers <- (md > cutoff) | (rd > cutoff)
outliers <- rd > cutoff
#############################
# Run this separately for AraC and Clofa
# classic CCA
library(CCA)
library(CCP)
# Classical CCA
set.seed(124)
# cca.classical <- CCA::cc(x, y)
cca.classical <- CCA::cc(x[outliers,], y[outliers,])
# Canonical correlations
cca.classical$cor
cca.classical$xcoef
cca.classical$ycoef
cca.classical$scores$xscores
cca.classical$scores$yscores
cca.classical$scores$corr.Y.yscores
cca.classical$scores$corr.X.yscores
cca.classical$scores$corr.Y.xscores
# Standardized canonical coefficients
x_sd <- diag(sqrt(diag(cov(x[outliers,]))))
y_sd <- diag(sqrt(diag(cov(y[outliers,]))))
x_std_coef <- x_sd %*% cca.classical$xcoef
y_std_coef <- y_sd %*% cca.classical$ycoef
rownames(x_std_coef) <- colnames(x)
rownames(y_std_coef) <- colnames(y)
round(x_std_coef, 3)
round(y_std_coef, 3)
# Canonical scores
U <- scale(x[outliers,], center = TRUE, scale = FALSE) %*%
cca.classical$xcoef
V <- scale(y[outliers,], center = TRUE, scale = FALSE) %*%
cca.classical$ycoef
# Within-block loadings
loadings_x <- cor(x[outliers,], U)
loadings_y <- cor(y[outliers,], V)
# Cross-loadings
cross_x <- cor(x[outliers,], V)
cross_y <- cor(y[outliers,], U)
round(loadings_x, 3)
round(loadings_y, 3)
round(cross_x, 3)
round(cross_y, 3)
#####
# Robust CCA via ccaPP
library(ccaPP)
rcca.spearman <- ccaGrid(x[outliers,], y[outliers,], k=2, method = "spearman", standardize = F)
rcca.spearman$cor
rcca.spearman$A
rcca.spearman$B
#####
ylist[[l]] = list(x=x,
y=y,
outliers=outliers,
cutoff=cutoff,
# Canonical correlations
cca.fit=cca.classical,
cca.cor=cca.classical$cor,
loadingsx=round(loadings_x, 3),
loadingsy=round(loadings_y, 3),
crossx=round(cross_x, 3),
crossy=round(cross_y, 3),
rcca.spearman=rcca.spearman,
rcca.spearman.cor=rcca.spearman$cor
)
}
cors = t(sapply(ylist, `[[`, 6))
cors
outs = lapply(ylist, `[[`, 3)
lapply(outs, function(o){
sum(o)
})
