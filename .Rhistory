View(rcca.spearman)
compute_robust_cca <- function(X, Y, method = "spearman", ...) {
# 1. Fit the projection pursuit CCA model
# Passes extra arguments (e.g., maxiter, nNum) downstream if needed
fit <- ccaPP::ccaGrid(X, Y, method = method, ...)
# Ensure X and Y are matrices for matrix operations
X_mat <- as.matrix(X)
Y_mat <- as.matrix(Y)
# 2. Replicate internal robust scaling from the ccaGrid fit
X_scaled <- scale(X_mat, center = fit$centerX, scale = fit$scaleX)
Y_scaled <- scale(Y_mat, center = fit$centerY, scale = fit$scaleY)
# 3. Compute Canonical Variate Scores
x_scores <- X_scaled %*% fit$A
y_scores <- Y_scaled %*% fit$B
# Assign clean column names to the scores (e.g., CV1, CV2, ...)
num_dims <- ncol(x_scores)
dim_names <- paste0("CV", seq_len(num_dims))
colnames(x_scores) <- dim_names
colnames(y_scores) <- dim_names
# 4. Compute Loadings (Structure Correlations) using the chosen robust method
corr.X.xscores <- cor(X_mat, x_scores, method = method)
corr.Y.yscores <- cor(Y_mat, y_scores, method = method)
# 5. Compute Cross-Correlations (Cross Loadings)
corr.X.yscores <- cor(X_mat, y_scores, method = method)
corr.Y.xscores <- cor(Y_mat, x_scores, method = method)
# Return a structured list mirroring CCA::comput()
return(list(
cor            = fit$cor,
xscores        = x_scores,
yscores        = y_scores,
corr.X.xscores = corr.X.xscores,
corr.Y.yscores = corr.Y.yscores,
corr.X.yscores = corr.X.yscores,
corr.Y.xscores = corr.Y.xscores,
raw_fit        = fit             # Keeps the original ccaGrid object accessible
))
}
rcca.spearman <- compute_robust_cca(x[outliers,], y[outliers,], k=2, method = "spearman", standardize = F)
rcca.spearman$cor
rcca.spearman$A
# cca.classical <- CCA::cc(x, y)
cca.classical <- CCA::cc(x[outliers,], y[outliers,])
View(cca.classical)
compute_robust_cca <- function(X, Y, method = "spearman", ...) {
# 1. Fit the projection pursuit CCA model
# Passes extra arguments (e.g., maxiter, nNum) downstream if needed
fit <- ccaPP::ccaGrid(X, Y, method = method, ...)
# Ensure X and Y are matrices for matrix operations
X_mat <- as.matrix(X)
Y_mat <- as.matrix(Y)
# 2. Replicate internal robust scaling from the ccaGrid fit
X_scaled <- scale(X_mat, center = fit$centerX, scale = fit$scaleX)
Y_scaled <- scale(Y_mat, center = fit$centerY, scale = fit$scaleY)
# 3. Compute Canonical Variate Scores
x_scores <- X_scaled %*% fit$A
y_scores <- Y_scaled %*% fit$B
# Assign clean column names to the scores (e.g., CV1, CV2, ...)
num_dims <- ncol(x_scores)
dim_names <- paste0("CV", seq_len(num_dims))
colnames(x_scores) <- dim_names
colnames(y_scores) <- dim_names
# 4. Compute Loadings (Structure Correlations) using the chosen robust method
corr.X.xscores <- cor(X_mat, x_scores, method = method)
corr.Y.yscores <- cor(Y_mat, y_scores, method = method)
# 5. Compute Cross-Correlations (Cross Loadings)
corr.X.yscores <- cor(X_mat, y_scores, method = method)
corr.Y.xscores <- cor(Y_mat, x_scores, method = method)
# Return a structured list mirroring CCA::comput()
return(list(
cor            = fit$cor,
xcoef          = fit$A,
ycoef          = fit$B,
xscores        = x_scores,
yscores        = y_scores,
corr.X.xscores = corr.X.xscores,
corr.Y.yscores = corr.Y.yscores,
corr.X.yscores = corr.X.yscores,
corr.Y.xscores = corr.Y.xscores,
raw_fit        = fit             # Keeps the original ccaGrid object accessible
))
}
